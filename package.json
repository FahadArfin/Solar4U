{
  "name": "solar4u",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && npm run test:hosted",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "local:up": "node scripts/local-ops.mjs up",
    "local:down": "node scripts/local-ops.mjs down",
    "local:restart": "node scripts/local-ops.mjs restart",
    "local:status": "node scripts/local-ops.mjs status",
    "local:logs": "node scripts/local-ops.mjs logs",
    "local:uninstall": "node scripts/local-ops.mjs uninstall",
    "history:import": "docker compose run --rm price-worker node import-history.mjs",
    "scrape:run": "docker compose run --rm price-worker node run.mjs",
    "scrape:retailer": "node scripts/run-retailer.mjs",
    "roof-vision:test": "docker compose build roof-vision && docker run --rm solar4u-roof-vision python -m unittest -v test_algorithms.py",
    "roof-vision:logs": "docker compose logs -f roof-vision",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test services/price-worker/tests.mjs services/solar-engine/tests.mjs services/solar-engine/model.test.mjs services/diagram-service/tests.mjs tests/regressions.test.mjs tests/catalog.test.mjs tests/placement.test.mjs && node --experimental-strip-types --test tests/studio.test.mjs tests/roof.test.mjs",
    "test:hosted": "node --test tests/hosted.test.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "drizzle-orm": "0.45.2",
    "earcut": "^3.2.3",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2026.8.16",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "proj4": "^2.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.29",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
